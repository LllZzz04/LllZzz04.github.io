---
import { NAV_ITEMS, SITE } from '../config';
import { withBase } from '../utils/site';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.slice(basePath.length) || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="site-mark" href={withBase('/')} aria-label={`${SITE.name}的首页`}>
      {SITE.name}
    </a>

    <nav class="primary-nav" aria-label="主导航">
      {NAV_ITEMS.map((item) => (
        <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="github-link" href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换颜色主题">
        <span aria-hidden="true">◐</span>
        <span data-theme-label>深色</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-theme-toggle]');
    const label = button?.querySelector('[data-theme-label]');
    const root = document.documentElement;
    const updateLabel = () => {
      if (label) label.textContent = root.dataset.theme === 'dark' ? '浅色' : '深色';
    };

    updateLabel();
    button?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      root.style.colorScheme = next;
      try { localStorage.setItem('theme', next); } catch {}
      updateLabel();
    });
  })();
</script>
