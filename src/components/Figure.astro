---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={{ 'wide-figure': wide }}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes={wide ? '(max-width: 960px) 100vw, 920px' : '(max-width: 760px) 100vw, 720px'}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
