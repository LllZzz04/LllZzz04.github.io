---
import { getCollection } from 'astro:content';
import ArtCard from '../../components/ArtCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByDate } from '../../utils/site';

const artworks = sortByDate(await getCollection('art'));
---

<BaseLayout title="绘画 — 绘画与透视练习" description="一个用于展示绘画和透视练习的简洁作品集。">
  <div class="page shell">
    <header class="page-header">
      <p class="eyebrow">绘画练习</p>
      <h1>绘画</h1>
      <p>一个安静、简单的作品网格。点击图片可在新窗口查看大图；当前图片均为可替换的示例占位作品。</p>
    </header>
    <div class="art-grid">
      {artworks.map((artwork, index) => <ArtCard artwork={artwork} eager={index < 2} />)}
    </div>
  </div>
</BaseLayout>
