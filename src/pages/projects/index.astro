---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByDate } from '../../utils/site';

const projects = sortByDate(await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout
  title="项目 — RFIC、电子技术与工程实践"
  description="精选 RFIC、模拟电路和嵌入式系统项目。"
>
  <div class="page shell">
    <header class="page-header">
      <p class="eyebrow">工程实践</p>
      <h1>项目</h1>
      <p>用于记录工程与科研项目的背景、设计过程、结果和复盘。示例内容刻意不包含虚构实验数据。</p>
    </header>
    <div class="project-grid project-grid-full">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
